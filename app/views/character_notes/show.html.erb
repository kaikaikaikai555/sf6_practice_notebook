<h2>vs <%= @character_note.opponent_character %>（使用：<%= @character_note.my_character %>）</h2>

<hr>

<h3>【最重要ポイント】</h3>
<p><%= @character_note.key_point %></p>

<h3>【自分の意識・習得したいこと】</h3>
<p><%= @character_note.my_focus %></p>

<h3>【自分の悪癖・よくやるミス】</h3>
<p><%= @character_note.bad_habit %></p>

<hr>

<details>
  <summary>詳しい対策メモを開く</summary>
  <p><%= @character_note.content %></p>
</details>

<br>
<%= link_to "編集する", edit_character_note_path(@character_note) %> |
<%= link_to "一覧に戻る", character_notes_path %>

<hr class="my-6 border-gray-300">

<!-- 10秒反省：対戦ログ登録フォーム -->
<div class="bg-white p-4 rounded-lg shadow-md mb-6">
  <h2 class="text-xl font-bold mb-4">10秒反省（対戦ログ追加）</h2>

  <%= form_with(model: [@character_note, MatchLog.new], local: true) do |f| %>
    <!-- 勝敗選択 -->
    <div class="mb-4">
      <label class="block text-sm font-bold mb-2">結果</label>
      <div class="flex gap-4">
        <label class="flex items-center gap-1 cursor-pointer">
          <%= f.radio_button :result, 'WIN', class: "radio radio-primary" %>
          <span class="font-bold text-blue-600">WIN</span>
        </label>
        <label class="flex items-center gap-1 cursor-pointer">
          <%= f.radio_button :result, 'LOSE', class: "radio radio-error", checked: true %>
          <span class="font-bold text-red-600">LOSE</span>
        </label>
      </div>
    </div>

    <!-- 敗因タグ選択 -->
    <div class="mb-4">
      <label class="block text-sm font-bold mb-2">敗因タグ</label>
      <div class="flex flex-wrap gap-2">
        <%= f.collection_check_boxes :defeat_tag_ids, DefeatTag.all, :id, :name do |b| %>
          <label class="inline-flex items-center gap-1 bg-gray-100 px-3 py-1 rounded border cursor-pointer hover:bg-gray-200">
            <%= b.check_box %>
            <span class="text-sm"><%= b.text %></span>
          </label>
        <% end %>
      </div>
    </div>

    <!-- メモ -->
    <div class="mb-4">
      <%= f.label :memo, "一言メモ", class: "block text-sm font-bold mb-1" %>
      <%= f.text_field :memo, class: "w-full p-2 border rounded", placeholder: "例：対空意識が漏れていた" %>
    </div>

    <%= f.submit "ログを記録する", class: "w-full bg-blue-600 text-white font-bold py-2 rounded hover:bg-blue-700 cursor-pointer" %>
  <% end %>
</div>

<!-- 過去の対戦ログ一覧 -->
<div class="bg-white p-4 rounded-lg shadow-md">
  <h2 class="text-xl font-bold mb-4">対戦履歴</h2>
  <% if @character_note.match_logs.any? %>
    <ul class="divide-y divide-gray-200">
      <% @character_note.match_logs.order(created_at: :desc).each do |log| %>
        <li class="py-2">
          <div class="flex justify-between items-center">
            <span class="font-bold <%= log.result == 'WIN' ? 'text-blue-600' : 'text-red-600' %>">
              <%= log.result %>
            </span>
            <span class="text-xs text-gray-500"><%= log.created_at.strftime("%Y/%m/%d %H:%M") %></span>
          </div>
          <% if log.defeat_tags.any? %>
            <div class="flex flex-wrap gap-1 mt-1">
              <% log.defeat_tags.each do |tag| %>
                <span class="bg-red-100 text-red-800 text-xs px-2 py-0.5 rounded"><%= tag.name %></span>
              <% end %>
            </div>
          <% end %>
          <% if log.memo.present? %>
            <p class="text-sm text-gray-700 mt-1"><%= log.memo %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-500 text-sm">対戦ログはまだありません。</p>
  <% end %>
</div>
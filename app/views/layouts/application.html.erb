<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Sf6 Practice Notebook" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body style="margin: 0; font-family: sans-serif; background-color: #f3f4f6; color: #1f2937;">
    
    <%# 共通ヘッダーバー（ログイン中ユーザー ＆ ログアウトボタン） %>
    <% if user_signed_in? %>
      <header style="background-color: #ffffff; border-bottom: 1px solid #e5e7eb; padding: 12px 16px; display: flex; flex-direction: column; sm-flex-direction: row; justify-content: space-between; align-items: center; gap: 8px; box-sizing: border-box;">
        <div style="font-size: 13px; color: #4b5563; word-break: break-all;">
          ログイン中: <span style="font-weight: bold; color: #1f2937;"><%= current_user.email %></span>
        </div>
        <div>
          <%= link_to 'ログアウト', destroy_user_session_path, data: { turbo_method: :delete }, style: "display: inline-block; background-color: #f3f4f6; color: #dc2626; padding: 6px 12px; border-radius: 6px; text-decoration: none; font-size: 13px; font-weight: bold; border: 1px solid #d1d5db;" %>
        </div>
      </header>
    <% end %>

    <%# フラッシュメッセージ（ログイン成功・失敗などの通知） %>
    <div style="max-width: 800px; margin: 0 auto; padding: 0 16px;">
      <% if notice %>
        <p style="background-color: #d1fae5; color: #065f46; padding: 10px 14px; border-radius: 6px; margin-top: 12px; font-size: 14px; font-weight: bold;"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p style="background-color: #fee2e2; color: #991b1b; padding: 10px 14px; border-radius: 6px; margin-top: 12px; font-size: 14px; font-weight: bold;"><%= alert %></p>
      <% end %>
    </div>

    <%= yield %>
  </body>
</html>